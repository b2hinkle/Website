@page "/"
@using BrianHinkle.Shared.Components.Animation
@using BrianHinkle.Shared.Components.Portfolio
@using BrianHinkle.Shared.Components
@inject NavigationManager NavManager
@inject IJSRuntime jsRuntime;

<Slidly @ref="SlidlyComponent" autoInit=false />
<SALWrapper />

<!-- Nav Bar -->
<nav id="PortfolioNavbar" class="navbar fixed-top navbar-expand-sm navbar-dark" style="background-color: rgba(33, 37, 41, .75);">
	<div class="container-fluid">
        <a href="/" class="navbar-brand mb-0 h1">Brian Hinkle</a>
        <button id="NavbarExpandButton" type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarItems" aria-controls="navbarItems" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
        
		<div class="collapse navbar-collapse" id="navbarItems">
            <ul class="nav-pills navbar-nav ms-auto">
                <li class="nav-item">
                    <a id="experienceNavLink" class="nav-link" style="cursor: pointer;" onclick:preventDefault @onclick="@( () => ScrollToElementWithNavbarOffset("experience") )"      >Experience</a>
                </li>
                <li class="nav-item">
                    <a id="aboutNavLink" class="nav-link" style="cursor: pointer;" @onclick:preventDefault @onclick="@( () => ScrollToElementWithNavbarOffset("about")     )"      >About</a>
                </li>
                <li class="nav-item">
                    <a id="contactNavLink" class="nav-link" style="cursor: pointer;" @onclick:preventDefault @onclick="@( () => ScrollToElementWithNavbarOffset("contact")   )"      >Contact</a>
                </li>
                <li class="nav-item">
                    <a id="resumeNavLink" style="cursor: pointer;" target="_blank" rel="noopener noreferrer" href="/_content/BrianHinkle/pdf/Resume_BrianHinkle.pdf" class="nav-link")"      >
                        Resume <span class="oi oi-external-link" style="font-size: 0.7em; vertical-align: middle;" aria-hidden="true"></span>
                    </a>
                </li>
            </ul>
		</div>
	</div>
</nav>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content d-flex flex-column align-items-center justify-content-center">
        <video muted autoplay loop controls playsinline disablePictureInPicture controlsList="nodownload" src="@ModalPortfolioItem?.VideoSrc" style="width:80vw;" />
    </div>
  </div>
</div>

<!-- Scroll Indicator -->
<div id="ScrollIndicator" style="position:fixed; top:80%; left: 50%; z-index:5;"/>

<div class="GridPatternBG" style="position:fixed; width:100vw; height:100vh" /> @* fixed positioned bg for users to have something nice to see when something isn't there *@
<!-- Page's Content -->
<div id="SlidlyWrapper" style="overflow:hidden;"> @* hiding any overflow since I use a really large bg element that will overflow during page load *@
    <header id="header" class="ParallaxContainer d-flex flex-column align-items-center justify-content-center">
        @if (isMobile == null)
        {
            <div style="position:absolute; height:100%; width:100%;" class="d-flex flex-column align-items-center justify-content-center">
                <p class="text-white" style="font-size:2rem;">Loading video...</p>
            </div>
        }
        else if (isMobile == false)
        {
            <iframe id="HeaderVideo" class="LongFadeInOnStart ParallaxElement" data-parallaxspeed=".25" src=@($"https://www.youtube.com/embed/{HeaderYoutubeVideoId}?yt:stretch=16:9&vq=hd1080p&autoplay=1&loop=1&playlist={HeaderYoutubeVideoId}&color=red&mute=1&playsinline=1&iv_load_policy=3&rel=0&showinfo=0&autohide=1&controls=0&modestbranding=1") allowtransparency="true" frameborder="0" allow="autoplay; encrypted-media;" />
        }
        else if (isMobile == true)  // can't youtube embed autoplay on mobile so we'll just use the video tag for autoplay
        {
            <video id="HeaderVideo" class="LongFadeInOnStart ParallaxElement" data-parallaxspeed=".25" muted autoplay loop playsinline disablePictureInPicture src="/_content/BrianHinkle/videos/Portfolio/Header.mp4" />
        }
        <div class="QuickFadeInOnStart" style="position: absolute; min-height: 100%; min-width: 100%; background-color: rgba(26, 188, 156, .5);" />
        <div style="position:relative; width:100vw; height:100vh; display:flex; z-index:11;">
            <h2 style="align-self: flex-end; font-size: 2rem;" class="QuickFadeInOnStart text-white section-heading">
                BRIAN HINKLE - MULTIPLAYER GAME PROGRAMMER
            </h2>
        </div>
    </header>

    <section id="experience" class="page-section portfolio-section">
        <h2 class="section-heading text-center">Experience</h2>
    


        

        <PortfolioItem TitleText="Shipped Towers of Aghasba (Editors’ Choice Indies #1)" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Towers_of_Aghasba.mp4" Duration=">2 years" ProjectStatus="Receiving Updates" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Towers of Aghasba trailer from the 2023 PlayStation Showcase
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Worked as a full-time engineer at Dreamlit Games. The shown trailer features early beta footage.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    
                    <li>> Pre/Post-Launch Development Experience</li>
                    <ul style="list-style-type: none;">
                        <li>> Met deadlines for milestone builds (trailers, open playtest, Sony certification).</li>
                        <li>> Cleared Sony certification by addressing technical requirements checklist and key memory concerns via PS5 dev kit.</li>
                        <li>> Practiced proper live player-base coding practices, such as save progress preservation throughout patches/updates.</li>
                        <li>> Provided engineer insights to core team meeting discussions (design, tech animation, combat, multiplayer, engineering).</li>
                    </ul>
                    
                    <li>> Experience developing for open-world game genre.</li>
                    <li>> Created multiplayer-ready systems & features, supporting performant open-world gameplay for players.</li>
                    
                    <li>> Multiplayer</li>
                    <ul style="list-style-type: none;">
                        <li>> Led solution for client-side prediction & re-simulation for player movement. Established implementation patterns, guided team adoption, and coordinated engineer efforts.</li>
                        <li>> Refactored existing systems for networked gameplay, developing for prediction and rollback in the process.</li>
                        <li>> Minimized network latency and resolved issues within existing systems, bringing to production ready state.</li>
                    </ul>
                    
                    <li>> Self-driven efforts</li>
                    <ul style="list-style-type: none;">
                        <li>> Performance improvements, dependency minimization, logic nativization, debug tools, documentation.</li>
                        <li>> Diagnosed & resolved issues immediately during playtests and improved QA iteration with new workflows.</li>
                    </ul>

                </ul>
            </Contributions>
        </PortfolioItem>
        <PortfolioItem TitleText="Game Utilities" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_StrengthCollisionQueries.mp4" TeamSize="2" Duration="~2 months" ProjectStatus="Receiving Updates" GithubLink1="https://github.com/b2hinkle/GameCore/tree/master" GithubLink1Name="Github" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Core utility queries used as sphere sweeps in a shooter-type game.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Developed C++ utilities shared across various projects, including Towers of Aghasba.
                    This module promotes modern C++ practices in Unreal Engine and the use of inline storage for common operations.
                    Common utilities include gameplay, math, collision, logging, debugging, safety, and language tools.
                </p>
                <p class="PortfolioItemParagraph">
                    This video demonstrates some custom collision queries that depend on the concept of strength.
                    Making use of penetration and ricochet casting, strength queries become weaker as they travel through the world.
                    All queries stay agnostic to collision shape to support a wide range of needs.
                </p>
                <p class="PortfolioItemParagraph">
                    Penetration scene casts pass through blocking hits until a specified condition is met, and returned data preserves the
                    distinction between blocking hits and overlaps. Exit hits can optionally be included in the return data, ordered in the
                    correct direction of the query.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> Wrote a size-generic bitfield abstraction for gameplay tag driven bit packing.</li>
                    <li>> Implemented shape-agnostic traces capable of exit hits, penetration, ricochets, and strength.
                        Improved performance up to 40% via custom query-area minimization algorithm.</li>
                    <li>> Developed utilities for cast safety, eliminating silent undefined behavior.</li>
                    <li>> Created templating solutions (SFINAE and C++ concepts) for improved workflows.</li>
                    <li>> Wrote utilities promoting the usage of inline storage.</li>
                    <li>> Implemented print-to-screen tools, using temporary lifetime for code execution with the named parameter idiom pattern.</li>
                    <li>> Developed generic property wrapper for responding to value changes.</li>
                    <li>> Wrote other common utilities (math, collision, debugging, string, logging, materials)..</li>
                </ul>
            </Contributions>
        </PortfolioItem>
        <PortfolioItem TitleText="C++ Utilities" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_CppUtils.mp4" TeamSize="1" Duration="~2 months" ProjectStatus="Receiving Updates" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Example demo of both container interfaces and custom access utilities. Includes benchmark via assembly instruction analysis.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    A collection of portable C++ libraries I’ve developed for use across a wide range of engines.
                </p>
                <p class="PortfolioItemParagraph">
                    <img src="/_content/BrianHinkle/images/github_small.png" style="width:1rem; margin: 0 .1rem;" />
                    <a href="https://github.com/b2hinkle/CppUtils_ContainerInterfaces/tree/master" target="_blank" rel="noopener noreferrer">Container interfaces</a> are a zero-cost, compile-time abstraction layer for containers, eliminating the need to depend on concrete types.
                    This allows generic code to operate on a wide variety of container types while keeping
                    static type safety.
                    The abstraction layer has no observable side effects and is therefore fully eliminated under the standard C++ "as-if" rule. The resulting
                    performance is equivalent to direct, container-specific calls. The identical generated assembly demonstrates this equivalence (try it out on <a href="https://godbolt.org/z/KcbYYvhY9" target="_blank" rel="noopener noreferrer">Godbolt</a>).
                </p>
                <p class="PortfolioItemParagraph">
                    <img src="/_content/BrianHinkle/images/github_small.png" style="width:1rem; margin: 0 .1rem;" />
                    <a href="https://github.com/b2hinkle/CppUtils_CustomAccess" target="_blank" rel="noopener noreferrer">Custom Accessed</a> is a header-only library that gives full control over data access behavior at zero cost. Data can be given a user-defined API (getter/setter) via callable type(s). Behaviors are fully reusable and swappable, allowing developers to
                    compose, share, and enforce access behavior without resorting to common encapsulation boilerplate. Encapsulation is preserved, data layout is predictable, and only explicitly defined behavior is permitted.
                </p>
                <p class="PortfolioItemParagraph">
                    <img src="/_content/BrianHinkle/images/github_small.png" style="width:1rem; margin: 0 .1rem;" />
                    <a href="https://github.com/ChristianHinkle/CppUtils_Misc" target="_blank" rel="noopener noreferrer">Misc Utilities</a> provides general purpose development utilities, including type traits, mixins, concepts, type probes, and other template metaprogramming tools.
                </p>
            </Description>
@*          Did all of it (except misc, but trying to keep things organized here).
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> </li>
                </ul>
            </Contributions>*@
        </PortfolioItem>
        <PortfolioItem TitleText="Ability System Setup" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_AbilitySystemSetupAndInputSetupCombined.mp4" TeamSize="2" Duration="~1 year" ProjectStatus="Receiving Updates" GithubLink1="https://github.com/ChristianHinko/AbilitySystemSetup" GithubLink1Name="Github" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Demo of avatar actor extension components, ability sets, and modular input workflow.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Developed a plugin providing essential integration logic for Epic’s Gameplay Ability System without imposing on design.
                    This plugin provides a flexible foundation with generalized structs and addresses common issues encountered with the ability system.
                    Leveraging a plugin that I have previously developed, it also provides a complete in-editor workflow for assigning abilities to inputs via gameplay tags.
                    This creates more possibilities with input than the ability system originally offered.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> <img src="/_content/BrianHinkle/images/github_small.png" style="width:1rem; margin: 0 .1rem;" /> <a href="https://github.com/ChristianHinkle/InputSetup" target="_blank" rel="noopener noreferrer">Input Setup</a> Wrote fully decoupled and modular input management solution, with support across game and plugin modules.</li>
                    <li>> Developed a more flexible solution for ability input binding, improving workflows and unlocking new capabilities.</li>
                    <li>> Developed portable avatar actor extension system, properly initializing/uninitializing avatars regardless of type or location.</li>
                    <li>> Developed other various ability system related utilities.</li>
                </ul>
            </Contributions>
        </PortfolioItem>
        <PortfolioItem TitleText="Multiplayer Web Framework" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_MultiplayerWebFramework.mp4" TeamSize="1" Duration="~9 months" ProjectStatus="Finished" GithubLink1="https://github.com/b2hinkle/MultiplayerWebFramework" GithubLink1Name="Github" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Dedicated server management through the management console.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Created an engine-agnostic solution for dedicated server management, supporting multiple host machines and game instances.
                    Using this framework, managing your servers is as easy as controlling it all from a single management UI.
                </p>
                <p>
                    This framework was used during the development of personal multiplayer game projects.
                </p>
            </Description>
            
@*          Since I did all of this project, I'm leving this section out.
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> </li>
                    <li>> </li>
                </ul>
            </Contributions> *@

        </PortfolioItem>


        
    </section>



        
    <!-- Page ending content -->
    <div class="ParallaxContainer" style="position:relative;">
        <div class="EndingBackground ParallaxElement" data-parallaxspeed=".3" style="position:absolute;"/> @* radial gradients *@

        <!-- About Section -->
        <div id="about" class="page-section text-white mb-0 mt-0 pb-6 pt-5">
            <div class="container text-center">

                <img src="/_content/BrianHinkle/images/Portrait.png" style="width: 100px; border-radius: 50%; opacity: 75%;">

                <!-- About Section Heading -->
                <h2 class="section-heading text-center text-uppercase" style="padding-bottom:2rem; padding-top:2rem;">About Me</h2>
            
                <!-- Make divider here... -->
                <div class="row">
                    <div class="col-lg-2"/>
                    <div data-sal-wrapper="fade" class="col-lg-8">
                        <p class="lead AboutSectionParagraph">
                            Hi there! I'm Brian Hinkle, a dedicated C++ programmer with 8 years of experience developing game systems.
                            I have a deep passion for writing flexible C++ code, continually refining my skills and exploring new techniques to push my work to the next level.
                            Whether it's projects from work or projects from my own time, I'm always excited for some problem-solving!
                        </p>
                        <p class="lead AboutSectionParagraph">
                            Game development is a collaborative effort, and I thrive on working with others.
                            Whether it's hashing out technical challenges with fellow engineers, or sharing insights with designers and artists, I’m always eager to bring my technical expertise and take on new challenges.
                            Let’s build something amazing together!
                        </p>
                    </div>
                    <div class="col-lg-2"/>
                </div>
            </div>
        </div>


        @if (showGetformContactSection)
        {
            <div class="page-section">
                <h2 class="section-heading text-center text-uppercase" style="padding-bottom:2rem;">Contact Me</h2>
                <GetformContact />
            </div>
        }
        <!-- Footer -->
        <footer class="text-center" style="padding: 32px 0; background-color: rgba(44, 62, 80, .3); color: #fff; font-size:.75rem;">
            <div id="contact" class="container">
                <div class="row">
                    <!-- Email -->
                    <div class="col-4">
                        <img src="/_content/BrianHinkle/images/contact-email.png" style="height:1.6rem; margin:.75rem;"/>
                        <br>
                        b2hinkle@gmail.com
                    </div>
                    <!-- Github -->
                    <div class="col-4">
                        <img src="/_content/BrianHinkle/images/contact-github.png" style="height:2.5rem; margin:.25rem;"/>
                        <br>
                        <a href="https://github.com/b2hinkle" target="_blank" rel="noopener noreferrer">b2hinkle</a>
                    </div>
                    <!-- Linkedin -->
                    <div class="col-4">
                        <img src="/_content/BrianHinkle/images/contact-linkedin.png" style="height:2.1rem; margin:.5rem;"/>
                        <br>
                        <a href="https://www.linkedin.com/in/brian-hinkle-0320801b5" target="_blank" rel="noopener noreferrer">Linkedin</a>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Copyright Section -->
        <div class="d-flex align-items-center justify-content-center text-center text-white" style="height: 15px; width: 100%; padding-top: 1.5rem; padding-bottom: 1.5rem; background-color: #1a252f;">
            @*<small>Copyright &copy; Your Website 2021</small>*@
            <small>@year Brian Hinkle</small>
        </div>
    </div>
</div>
        


    


@code 
{
    private bool showGetformContactSection = false;
    private IJSObjectReference jsObjRef;    // js interactor
    private Slidly SlidlyComponent;
    private int year = DateTime.Now.Year;
    private PortfolioItem ModalPortfolioItem;
    private bool? isMobile { get; set; } = null;
    private string HeaderYoutubeVideoId = "ph0ITWPQYwo";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsObjRef = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/BrianHinkle/Pages/Index.razor.js");
            await jsObjRef.InvokeVoidAsync("OnAfterRenderAsync");

            isMobile = await jsRuntime.InvokeAsync<bool>("isMobile");
            StateHasChanged();
            await SlidlyComponent.Init();
        }
    }

    public async Task ScrollToElementWithNavbarOffset(string elementId)
    {
        await jsObjRef.InvokeVoidAsync("ScrollToElementWithNavbarOffset", elementId);
    }

    public async void ShowPopupModal(PortfolioItem PortfolioItemToShowModelFor)
    {
        ModalPortfolioItem = PortfolioItemToShowModelFor;
        await jsObjRef.InvokeVoidAsync("ShowPopupModal");
    }
}
