@page "/"
@using BrianHinkle.Shared.Components.Animation
@using BrianHinkle.Shared.Components.Portfolio
@using BrianHinkle.Shared.Components
@inject NavigationManager NavManager
@inject IJSRuntime jsRuntime;

<Slidly @ref="SlidlyComponent" autoInit=false />
<SALWrapper />

<!-- Nav Bar -->
<nav id="PortfolioNavbar" class="navbar fixed-top navbar-expand-sm navbar-dark" style="background-color: rgba(33, 37, 41, .75);">
	<div class="container-fluid">
        <a href="/" class="navbar-brand mb-0 h1">Brian Hinkle</a>
        <button id="NavbarExpandButton" type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarItems" aria-controls="navbarItems" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
        
		<div class="collapse navbar-collapse" id="navbarItems">
            <ul class="nav-pills navbar-nav ms-auto">
                <li class="nav-item">
                    <a id="projectsNavLink" class="nav-link" style="cursor: pointer;" onclick:preventDefault @onclick="@( () => ScrollToElementWithNavbarOffset("projects") )"      >Projects</a>
                </li>
                <li class="nav-item">
                    <a id="aboutNavLink" class="nav-link" style="cursor: pointer;" @onclick:preventDefault @onclick="@( () => ScrollToElementWithNavbarOffset("about")     )"      >About</a>
                </li>
                <li class="nav-item">
                    <a id="contactNavLink" class="nav-link" style="cursor: pointer;" @onclick:preventDefault @onclick="@( () => ScrollToElementWithNavbarOffset("contact")   )"      >Contact</a>
                </li>
            </ul>
		</div>
	</div>
</nav>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content d-flex flex-column align-items-center justify-content-center">
        <video muted autoplay loop controls playsinline disablePictureInPicture controlsList="nodownload" src="@ModalPortfolioItem?.VideoSrc" style="width:80vw;" />
    </div>
  </div>
</div>

<!-- Scroll Indicator -->
<div id="ScrollIndicator" style="position:fixed; top:80%; left: 50%; z-index:5;"/>

<div class="GridPatternBG" style="position:fixed; width:100vw; height:100vh" /> @* fixed positioned bg for users to have something nice to see when something isn't there *@
<!-- Page's Content -->
<div id="SlidlyWrapper" style="overflow:hidden;"> @* hiding any overflow since I use a really large bg element that will overflow during page load *@
    <header id="header" class="ParallaxContainer d-flex flex-column align-items-center justify-content-center">
        @if (isMobile == null)
        {
            <div style="position:absolute; height:100%; width:100%;" class="d-flex flex-column align-items-center justify-content-center">
                <p class="text-white" style="font-size:2rem;">Loading video...</p>
            </div>
        }
        else if (isMobile == false)
        {
            <iframe id="HeaderVideo" class="LongFadeInOnStart ParallaxElement" data-parallaxspeed=".25" src=@($"https://www.youtube.com/embed/{HeaderYoutubeVideoId}?yt:stretch=16:9&vq=hd1080p&autoplay=1&loop=1&playlist={HeaderYoutubeVideoId}&color=red&mute=1&playsinline=1&iv_load_policy=3&rel=0&showinfo=0&autohide=1&controls=0&modestbranding=1") allowtransparency="true" frameborder="0" allow="autoplay; encrypted-media;" />
        }
        else if (isMobile == true)  // can't youtube embed autoplay on mobile so we'll just use the video tag for autoplay
        {
            <video id="HeaderVideo" class="LongFadeInOnStart ParallaxElement" data-parallaxspeed=".25" muted autoplay loop playsinline disablePictureInPicture src="/_content/BrianHinkle/videos/Portfolio/Header.mp4" />
        }
        <div class="QuickFadeInOnStart" style="position: absolute; min-height: 100%; min-width: 100%; background-color: rgba(26, 188, 156, .5);" />
        <div style="position:relative; width:100vw; height:100vh; display:flex; z-index:11;">
            <h2 style="align-self: flex-end; font-size: 2rem;" class="QuickFadeInOnStart text-white section-heading">
                BRIAN HINKLE - MULTIPLAYER GAME PROGRAMMER
            </h2>
        </div>
    </header>

    <section id="projects" class="page-section portfolio-section">
        <h2 class="section-heading text-center">Experience</h2>
    


        

        <PortfolioItem TitleText="Fulltime Engineer at Dreamlit Games" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Towers_of_Aghasba.mp4" Duration="2 years" ProjectStatus="Receiving Updates" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Towers of Aghasba trailer from the 2023 PlayStation Showcase
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Editors Choice Indies #1 place award. Towers of Aghasba is an open-world action-adventure builder game set in a unique fantasy world.
                    Players are challenged to rebuild their civilization and the ecosystem, maintaining a balance between the two.
                    The trailer shown features early beta footage.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    
                    <li>> Pre/Post-Launch Development Experience</li>
                    <ul style="list-style-type: none;">
                        <li>> Met time requirements for milestone builds (trailers, open playtest, Sony certification).</li>
                        <li>> Addressed Sony technical requirements and major memory concerns utilizing PS5 dev kit.</li>
                        <li>> Practiced proper live player-base coding practices, such as save progress preservation throughout patches/updates.</li>
                        <li>> Provided engineer insights to core team meeting discussions (design, tech animation, combat, multiplayer, engineering).</li>
                    </ul>
                    
                    <li>> Experience in developing for open-world game genre.</li>
                    <li>> Implemented performant game systems, all fully supported in multiplayer environments.</li>
                    
                    <li>> Multiplayer</li>
                    <ul style="list-style-type: none;">
                        <li>> Led client-side prediction and rewind-and-replay solution for player movement.</li>
                        <li>> Refactored existing systems for networked gameplay, accounting for gameplay rollback in the process.</li>
                        <li>> Took initiative to resolve issues and minimize network latency within existing multiplayer systems.</li>
                    </ul>
                    
                    <li>> Self-driven efforts</li>
                    <ul style="list-style-type: none;">
                        <li>> Performance improvements, dependency minimization, logic nativization, debug tools, documentation.</li>
                        <li>> Diagnosed/addressed issues immediately during playtests. Improved testing workflows when pain points arose.</li>
                    </ul>

                </ul>
            </Contributions>
        </PortfolioItem>
        <PortfolioItem TitleText="Core Utilities" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_StrengthCollisionQueries.mp4" TeamSize="2" Duration="~2 months" ProjectStatus="Receiving Updates" GithubLink="https://github.com/b2hinkle/GameCore/tree/master" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Core utility queries used as sphere sweeps in a shooter-type game.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Developed C++ utilities shared across various projects, including Towers of Aghasba.
                    This module promotes modern C++ practices in Unreal Engine and the use of inline storage for common operations.
                    Common utilities include gameplay, math, collision, logging, debugging, and safety tools.
                </p>
                <p class="PortfolioItemParagraph">
                    This video demonstrates some custom collision queries that depend on the concept of strength.
                    Making use of penetration and ricocheting casting, strength queries become weaker as they travel through the world.
                    All queries stay agnostic to collision shape to support a wide range of needs.
                </p>
                <p class="PortfolioItemParagraph">
                    Penetration scene casts pass through blocking hits until a specified condition is met, and returned data preserves the
                    distinction between blocking hits and overlaps. Exit hits can optionally be included in the return data, ordered in the
                    correct direction of the query.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> Created tagged bitfield struct, capable of bit packing via gameplay tags with generic size bit operations.</li>
                    <li>> Implemented a type generic property wrapper for responding to value changes.</li>
                    <li>> Implemented shape agnostic traces, capable of exit hits, penetration, ricochets, and strength.
                            Optimized performance by up to 40% via custom query-area minimization algorithm.</li>
                    <li>> Developed checked object casting with the benefit of static casts, constrained by C++ concepts for compile time safety.</li>
                    <li>> Created templating solutions (SFINAE and C++ concepts) for improved workflows.</li>
                    <li>> Wrote code promoting the usage of inline storage and generic character types.</li>
                    <li>> Implemented print-to-screen tools, using temporary lifetime for code execution and the named parameter idiom technique.</li>
                    <li>> Wrote various utility functions (e.g. math, collision, debugging, string, logging, materials).</li>
                </ul>
            </Contributions>
        </PortfolioItem>
@*      NOTE: This is now an old item. Its info is now part of the Ability System Setup item below (info was improved and minimized).
        <PortfolioItem TitleText="Input Setup" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_InputSetup.mp4" TeamSize="2" Duration="~1 month" ProjectStatus="Receiving Updates" GithubLink="https://github.com/ChristianHinko/InputSetup" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Editor workflow for input actions by both the game project and a plugin.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Developed a C++ plugin that creates powerful workflows for gameplay input in both code and editor.
                    It facilitates input actions in a special way, creating a configurable mapping system with minimal integration effort.
                    External modules, including dynamically loaded game feature modules, can easily integrate and contribute to the player’s input.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> Wrote subsystem for consolidated input action asset references along with editor workflows.</li>
                    <ul style="list-style-type: none;">
                        <li>> Add/remove workflow for both game project and plugin input actions.</li>
                        <li>> Input action bookkeeping between game project and plugin input actions.</li>
                    </ul>
                    <li>> Developed modular extension logic for adding/removing input mappings.</li>
                </ul>
            </Contributions>
        </PortfolioItem> *@
        <PortfolioItem TitleText="Ability System Setup" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_AbilitySystemSetupAndInputSetupCombined.mp4" TeamSize="2" Duration="~2 years" ProjectStatus="Receiving Updates" GithubLink="https://github.com/ChristianHinko/AbilitySystemSetup" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Demo of avatar actor extension components, ability sets, and modular input workflow.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Developed a plugin providing essential integration logic for Epic’s Gameplay Ability System without imposing on design.
                    This plugin provides a flexible foundation with generalized structs and addresses common issues encountered with the ability system.
                    Leveraging a plugin that I have previously developed, it also provides a complete in-editor workflow for assigning abilities to inputs via gameplay tags.
                    This creates more possibilities with input than the ability system originally offered.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> Wrote fully decoupled and modular input management solution, with support across game and plugin modules.</li>
                    <li>> Developed a more flexible solution for ability input binding, with improved workflow and capabilities.</li>
                    <li>> Developed avatar actor extension system, properly initializing/uninitializing avatars regardless of type or location. Extension logic stays completely separate from UObjects.</li>
                    <li>> Developed various ability system related utilities.</li>
                </ul>
            </Contributions>
        </PortfolioItem>
        <PortfolioItem TitleText="Multiplayer Web Framework" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_MultiplayerWebFramework.mp4" TeamSize="1" Duration="~9 months" ProjectStatus="Finished" GithubLink="https://github.com/b2hinkle/MultiplayerWebFramework" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                Dedicated server management through the management console.
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Created an engine-agnostic solution for dedicated server management, supporting multiple host machines and game instances.
                    Using this framework, managing your servers is as easy as controlling it all from a single management console. This framework was
                    tested during the development of a personal multiplayer game project.
                </p>
            </Description>
            
@*          Since I did all of this project, I'm leving this section out.
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> </li>
                    <li>> </li>
                </ul>
            </Contributions> *@

        </PortfolioItem>
        @*<PortfolioItem TitleText="Property Wrapper" VideoSrc="/_content/BrianHinkle/videos/Portfolio/Demos/Demo_PropertyWrapper.mp4" TeamSize="2" Duration="~16 months" ProjectStatus="Finished" GithubLink="https://github.com/b2hinkle/GameCore/tree/master/Source/GameCore/Public/Types/PropertyWrappers" OnFullscreenBtnPressed=@ShowPopupModal>
            <VideoSubtext>
                ClipAmmo as an integer property wrapper to print to the screen on value changes!
            </VideoSubtext>
            <Description>
                <p class="PortfolioItemParagraph">
                    Developed a generic property wrapper that allows users to respond to changes in values. This simplifies and
                    cleans up code bases. Initially developed to improve the workflow of push model replication, Property Wrapper’s use has become
                    more diverse. The wrapper is implemented as a lightweight UStruct, with functionality implemented generically across all types.
                </p>
            </Description>
            <Contributions>
                <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li>> Developed method for implementing generic type logic on a UStruct</li>
                    <li>> Developed implementation of the property wrapper</li>
                    <ul style="list-style-type: none;">
                        <li>> Initialization logic</li>
                        <li>> Auto push model replication</li>
                        <li>> Value change event</li>
                        <li>> Generic implementation for serialization and net serialization</li>
                    </ul>
                </ul>
            </Contributions>
        </PortfolioItem>*@


        
    </section>



        
    <!-- Page ending content -->
    <div class="ParallaxContainer" style="position:relative;">
        <div class="EndingBackground ParallaxElement" data-parallaxspeed=".3" style="position:absolute;"/> @* radial gradients *@

        <!-- About Section -->
        <div id="about" class="page-section text-white mb-0">
            <div class="container">
                <!-- About Section Heading -->
                <h2 class="section-heading text-center text-uppercase" style="padding-bottom:2rem;">About Me</h2>
            
                <!-- Make divider here... -->
                <div class="row">
                    <div class="col-lg-2"/>
                    <div data-sal-wrapper="fade" class="col-lg-8">
                        <p class="lead AboutSectionParagraph">
                            Hi there! I'm Brian Hinkle, a dedicated C++ programmer with 7 years of experience developing game systems.
                            I have a deep passion for writing flexible C++ code, always refining my skills and exploring new techniques to push my work to the next level.
                            Whether it's projects from work or projects from my own time, I'm always excited for some problem-solving!
                        </p>
                        <p class="lead AboutSectionParagraph">
                            Game development is a collaborative effort, and I thrive on working with others.
                            Whether it's hashing out technical challenges with fellow engineers, or sharing insights with designers and artists, I’m always eager to bring my technical expertise and take on new challenges.
                            Let’s build something amazing together!
                        </p>
                    </div>
                    <div class="col-lg-2"/>
                </div>
            </div>
        </div>


        @if (showGetformContactSection)
        {
            <div class="page-section">
                <h2 class="section-heading text-center text-uppercase" style="padding-bottom:2rem;">Contact Me</h2>
                <GetformContact />
            </div>
        }
        <!-- Footer -->
        <footer class="text-center" style="padding: 32px 0; background-color: rgba(44, 62, 80, .3); color: #fff; font-size:.75rem;">
            <div id="contact" class="container">
                <div class="row">
                    <!-- Email -->
                    <div class="col-4">
                        <img src="/_content/BrianHinkle/images/contact-email.png" style="height:1.6rem; margin:.75rem;"/>
                        <br>
                        b2hinkle@gmail.com
                    </div>
                    <!-- Github -->
                    <div class="col-4">
                        <img src="/_content/BrianHinkle/images/contact-github.png" style="height:2.5rem; margin:.25rem;"/>
                        <br>
                        <a href="https://github.com/b2hinkle" target="_blank" rel="noopener noreferrer">b2hinkle</a>
                    </div>
                    <!-- Linkedin -->
                    <div class="col-4">
                        <img src="/_content/BrianHinkle/images/contact-linkedin.png" style="height:2.1rem; margin:.5rem;"/>
                        <br>
                        <a href="https://www.linkedin.com/in/brian-hinkle-0320801b5" target="_blank" rel="noopener noreferrer">Linkedin</a>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Copyright Section -->
        <div class="d-flex align-items-center justify-content-center text-center text-white" style="height: 15px; width: 100%; padding-top: 1.5rem; padding-bottom: 1.5rem; background-color: #1a252f;">
            @*<small>Copyright &copy; Your Website 2021</small>*@
            <small>@year Brian Hinkle</small>
        </div>
    </div>
</div>
        


    


@code 
{
    private bool showGetformContactSection = false;
    private IJSObjectReference jsObjRef;    // js interactor
    private Slidly SlidlyComponent;
    private int year = DateTime.Now.Year;
    private PortfolioItem ModalPortfolioItem;
    private bool? isMobile { get; set; } = null;
    private string HeaderYoutubeVideoId = "ph0ITWPQYwo";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsObjRef = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/BrianHinkle/Pages/Index.razor.js");
            await jsObjRef.InvokeVoidAsync("OnAfterRenderAsync");

            isMobile = await jsRuntime.InvokeAsync<bool>("isMobile");
            StateHasChanged();
            await SlidlyComponent.Init();
        }
    }

    public async Task ScrollToElementWithNavbarOffset(string elementId)
    {
        await jsObjRef.InvokeVoidAsync("ScrollToElementWithNavbarOffset", elementId);
    }

    public async void ShowPopupModal(PortfolioItem PortfolioItemToShowModelFor)
    {
        ModalPortfolioItem = PortfolioItemToShowModelFor;
        await jsObjRef.InvokeVoidAsync("ShowPopupModal");
    }
}
