<div style="padding: 6rem 0; font-size:.75rem;">
    <div class="container text-white clearfix" style="position:relative;">
        <div class="col-md-6 float-md-start mx-4" style="position:relative;">
            <div style="width:100%; height:100%; overflow:hidden;">
                <div id="PortfolioItemVideoDiv" onclick="@OnFullecreenBtnPressed" class="d-flex flex-column align-items-center justify-content-center" style="overflow:hidden; width:100%; height:100%;">
                    <video muted autoplay loop playsinline disablePictureInPicture src="@VideoSrc" style="width:100%; cursor: pointer;" />
                    <div id="PortfolioItemVideoDivDarkOverlay" />
                    <svg id="FullscreenIcon" fill="currentColor" class="bi bi-arrows-fullscreen" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M5.828 10.172a.5.5 0 0 0-.707 0l-4.096 4.096V11.5a.5.5 0 0 0-1 0v3.975a.5.5 0 0 0 .5.5H4.5a.5.5 0 0 0 0-1H1.732l4.096-4.096a.5.5 0 0 0 0-.707zm4.344 0a.5.5 0 0 1 .707 0l4.096 4.096V11.5a.5.5 0 1 1 1 0v3.975a.5.5 0 0 1-.5.5H11.5a.5.5 0 0 1 0-1h2.768l-4.096-4.096a.5.5 0 0 1 0-.707zm0-4.344a.5.5 0 0 0 .707 0l4.096-4.096V4.5a.5.5 0 1 0 1 0V.525a.5.5 0 0 0-.5-.5H11.5a.5.5 0 0 0 0 1h2.768l-4.096 4.096a.5.5 0 0 0 0 .707zm-4.344 0a.5.5 0 0 1-.707 0L1.025 1.732V4.5a.5.5 0 0 1-1 0V.525a.5.5 0 0 1 .5-.5H4.5a.5.5 0 0 1 0 1H1.732l4.096 4.096a.5.5 0 0 1 0 .707z"></path>
                    </svg>
                </div>
            </div>
            <p style="color:#a1a1a1; font-size: x-small; padding-top:5px;">@VideoSubtext</p>
        </div>

        @if (TitleText != null)
        {
            <span class="text-white portfolio-item-title">@TitleText</span>
        }
        @if (GithubLink1 != null || GithubLink2 != null)
        {
                <span style="font-style:italic; margin-left: 5px;">
                    <img src="/_content/BrianHinkle/images/github_small.png" style="width:1rem; margin: 0 .5rem;" />
                    @if (GithubLink1 != null)
                    {
                        <span style="font-style:italic;">
                            <a href="@GithubLink1" target="_blank" rel="noopener noreferrer">@GithubLink1Name</a>
                        </span>
                    }
                    @if (GithubLink2 != null)
                    {
                        <span style="font-style:italic; margin-left: 8px;">
                            <a href="@GithubLink2" target="_blank" rel="noopener noreferrer">@GithubLink2Name</a>
                        </span>
                    }
                </span>
        }
        <br>
        <small style="font-style:italic;">
            @builtString
        </small>
        <hr>
        @if (Description != null)
        {
            <div data-sal-wrapper="fade" style="padding: 0 10px;">
                @Description
            </div>
        }

    </div>
    <br>
    @if (Contributions != null)
    {
        <div data-sal-wrapper="fade" class="container text-white">
            <b>Contributions:</b>
            <p>
                @Contributions
            </p>
        </div>
    }
</div>

@code 
{
    private static string GithubLinkNameDefault = "Github";

    [Parameter]
    public string? TitleText { get; set; } = null;
    [Parameter]
    public string? GithubLink1 { get; set; } = null;
    [Parameter]
    public string? GithubLink1Name { get; set; } = GithubLinkNameDefault;
    [Parameter]
    public string? GithubLink2 { get; set; } = null;
    [Parameter]
    public string? GithubLink2Name { get; set; } = GithubLinkNameDefault;
    [Parameter]
    public string? TeamSize { get; set; } = null;
    [Parameter]
    public string? Duration { get; set; } = null;
    [Parameter]
    public string? ProjectStatus{ get; set; } = null;
    private string builtString = "";

    [Parameter]
    public RenderFragment Contributions { get; set; }
    [Parameter]
    public RenderFragment Description { get; set; }
    [Parameter]
    public RenderFragment VideoSubtext { get; set; }
    [Parameter]
    public string VideoSrc { get; set; }

    [Parameter]
    public EventCallback<PortfolioItem> OnFullscreenBtnPressed { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        builtString = "";
        if (TeamSize != null)
        {
            builtString += ("Team Size: " + TeamSize + " | ");
        }
        if (Duration != null)
        {
            builtString += ("Duration: " + Duration + " | ");
        }
        if (ProjectStatus != null)
        {
            builtString += ("Project Status: " + ProjectStatus);
        }
    }

    async private void OnFullecreenBtnPressed()
    {
        await OnFullscreenBtnPressed.InvokeAsync(this);
    }
}
